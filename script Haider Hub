local function createFeatureToggle(parent, name, posY, text, callback)
	local label = Instance.new("TextLabel")
	label.Parent = parent
	label.BackgroundTransparency = 1
	label.Position = UDim2.new(0.05, 0, 0, posY)
	label.Size = UDim2.new(0, 180, 0, 35)
	label.Font = Enum.Font.SourceSansBold
	label.Text = text
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextSize = 13
	label.TextXAlignment = Enum.TextXAlignment.Left

	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.Parent = parent
	btn.BackgroundColor3 = Color3.fromRGB(150, 30, 30)
	btn.BorderColor3 = Color3.fromRGB(0, 255, 128)
	btn.Position = UDim2.new(0.58, 0, 0, posY)
	btn.Size = UDim2.new(0, 115, 0, 35)
	btn.Font = Enum.Font.SourceSansBold
	btn.Text = "إيقاف [❌]"
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextSize = 13

	local state = false
	btn.MouseButton1Click:Connect(function()
		state = not state
		if state then
			btn.Text = "تشغيل [✔️]"
			btn.BackgroundColor3 = Color3.fromRGB(30, 150, 60)
		else
			btn.Text = "إيقاف [❌]"
			btn.BackgroundColor3 = Color3.fromRGB(150, 30, 30)
		end
		callback(state)
	end)
	return btn
end

