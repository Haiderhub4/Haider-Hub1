speedBox.TextSize = 11

speedBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		local num = tonumber(speedBox.Text)
		if num then
			customSpeed = num
			if speedActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
				LocalPlayer.Character.Humanoid.WalkSpeed = customSpeed
			end
		end
	end
end)

-- 5. ميزة اختراق الجدران (Noclip)
createFeatureToggle("NoclipToggle", 235, "اختراق الجدران (Noclip)", function(state)
	noclipActive = state
end)

RunService.Stepped:Connect(function()
	if noclipActive then
		local Character = LocalPlayer.Character
		if Character then
			for _, part in pairs(Character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
		end
	end
	if speedActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
		LocalPlayer.Character.Humanoid.WalkSpeed = customSpeed
	end
end)

-- نظام قائمة المراقبة وانتقال اللاعبين المطور
local monitoredPlayer = nil

local function updatePlayerList()
	for _, child in pairs(Container2:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	local yPos = 10
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			local playerCard = Instance.new("Frame")
			playerCard.Parent = Container2
			playerCard.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
			playerCard.BorderColor3 = Color3.fromRGB(0, 255, 128)
			playerCard.Position = UDim2.new(0.05, 0, 0, yPos)
			playerCard.Size = UDim2.new(0, 220, 0, 65)

			local pLabel = Instance.new("TextLabel")
			pLabel.Parent = playerCard
			pLabel.BackgroundTransparency = 1
			pLabel.Position = UDim2.new(0.05, 0, 0, 2)
			pLabel.Size = UDim2.new(0.9, 0, 0, 22)
			pLabel.Font = Enum.Font.SourceSansBold
			pLabel.Text = p.Name
			pLabel.TextColor3 = Color3.fromRGB(0, 255, 128)
			pLabel.TextSize = 12
			pLabel.TextXAlignment = Enum.TextXAlignment.Left

			-- زر المراقبة
			local specBtn = Instance.new("TextButton")
			specBtn.Parent = playerCard
			specBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 140)
			specBtn.Position = UDim2.new(0.05, 0, 0, 28)
			specBtn.Size = UDim2.new(0, 100, 0, 30)
			specBtn.Font = Enum.Font.SourceSansBold
			specBtn.Text = "مراقبة الكاميرا"
			specBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			specBtn.TextSize = 10

			specBtn.MouseButton1Click:Connect(function()
				if monitoredPlayer == p then
					monitoredPlayer = nil
					Camera.CameraSubject = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
					specBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 140)
					specBtn.Text = "مراقبة الكاميرا"
				else
					monitoredPlayer = p
					if p.Character and p.Character:FindFirstChild("Humanoid") then
						Camera.CameraSubject = p.Character.Humanoid
						specBtn.BackgroundColor3 = Color3.fromRGB(30, 150, 60)
						specBtn.Text = "إيقاف المراقبة"
					end
				end
			end)

			-- زر الانتقال الفوري للاعب (TP)
			local tpBtn = Instance.new("TextButton")
			tpBtn.Parent = playerCard
			tpBtn.BackgroundColor3 = Color3.fromRGB(140, 90, 40)
			tpBtn.Position = UDim2.new(0.53, 0, 0, 28)
			tpBtn.Size = UDim2.new(0, 100, 0, 30)
			tpBtn.Font = Enum.Font.SourceSansBold
			tpBtn.Text = "انتقال إليه (TP)"
			tpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			tpBtn.TextSize = 10

			tpBtn.MouseButton1Click:Connect(function()
				if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
					LocalPlayer.Character.HumanoidRootPart.CFrame = p.Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
				end
			end)

			yPos = yPos + 75
		end
	end
end

