-- اللوب الخلفي لتنفيذ الميزات بسلاسة وبدون Lag
RunService.Stepped:Connect(function()
	local Character = LocalPlayer.Character
	if not Character or not Character:FindFirstChild("HumanoidRootPart") then return end
	local HumanoidRootPart = Character.HumanoidRootPart

	-- البحث عن الدروب الجوي (Airdrop) في الخريطة
	for _, obj in pairs(workspace:GetDescendants()) do
		if obj:IsA("Model") and (string.lower(obj.Name):find("airdrop") or string.lower(obj.Name):find("drop")) then
			local targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
			if targetPart then
				-- الانتقال التلقائي لمكان الدروب إذا كانت الميزة مفعلة
				if autoAirdropTp then
					HumanoidRootPart.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
				end
				-- فتح الدروب التلقائي عبر تفعيل الـ ProximityPrompt إذا كانت الميزة مفعلة
				if autoAirdropOpen then
					for _, prompt in pairs(obj:GetDescendants()) do
						if prompt:IsA("ProximityPrompt") then
							fireproximityprompt(prompt)
						end
					end
				end
			end
		end
	end

	-- حل المعادلات التلقائي والضغط على زر التأكيد
	if autoMathActive then
		for _, gui in pairs(LocalPlayer.PlayerGui:GetDescendants()) do
			if gui:IsA("TextLabel") or gui:IsA("TextBox") then
				local text = gui.Text
				local num1, num2 = text:match("(%d+)%s*%+%s*(%d+)")
				if num1 and num2 then
					local answer = tonumber(num1) + tonumber(num2)
					for _, box in pairs(gui.Parent:GetDescendants()) do
						if box:IsA("TextBox") then
							box.Text = tostring(answer)
						end
					end
					for _, btn in pairs(gui.Parent:GetDescendants()) do
						if btn:IsA("TextButton") and (string.lower(btn.Text):find("تأكيد") or string.lower(btn.Text):find("confirm")) then
							for _, connection in pairs(getconnections(btn.MouseButton1Click)) do
								connection:Fire()
							end
						end
					end
				end
			end
		end
	end
end)
