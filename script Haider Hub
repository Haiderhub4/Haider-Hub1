-- نظام التشغيل الموحد (الطيران والمشي معاً ويتجه نحو الكاميرا بسلاسة)
RunService.Stepped:Connect(function()
	local Character = LocalPlayer.Character
	if not Character then return end
	local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
	local Humanoid = Character:FindFirstChild("Humanoid")

	if noclipActive then
		for _, part in pairs(Character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end

	if speedActive and Humanoid then
		Humanoid.WalkSpeed = customSpeed
	end

	if flyActive and HumanoidRootPart and Camera then
		local bv = HumanoidRootPart:FindFirstChild("HaidarFlyVelocity")
		local bg = HumanoidRootPart:FindFirstChild("HaidarFlyGyro")
		if not bv then
			bv = Instance.new("BodyVelocity")
			bv.Name = "HaidarFlyVelocity"
			bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
			bv.Parent = HumanoidRootPart
			bg = Instance.new("BodyGyro")
			bg.Name = "HaidarFlyGyro"
			bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
			bg.Parent = HumanoidRootPart
		end
		
		local moveDir = Vector3.new()
		if Humanoid then
			moveDir = Humanoid.MoveDirection
		end
		
		if moveDir.Magnitude == 0 then
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
		else
			local joyX = Humanoid.MoveDirection:Dot(Camera.CFrame.RightVector)
			local joyZ = Humanoid.MoveDirection:Dot(Camera.CFrame.LookVector)
			moveDir = (Camera.CFrame.LookVector * joyZ) + (Camera.CFrame.RightVector * joyX)
		end
		
		bv.Velocity = moveDir * 55
		bg.CFrame = Camera.CFrame
		if Humanoid then Humanoid.PlatformStand = false end
	else
		if HumanoidRootPart then
			if HumanoidRootPart:FindFirstChild("HaidarFlyVelocity") then HumanoidRootPart.HaidarFlyVelocity:Destroy() end
			if HumanoidRootPart:FindFirstChild("HaidarFlyGyro") then HumanoidRootPart.HaidarFlyGyro:Destroy() end
		end
		if Humanoid then Humanoid.PlatformStand = false end
	end
end)

