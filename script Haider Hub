-- نظام قائمة المراقبة للناس (Spectate System)
local monitoredPlayer = nil

local function updatePlayerList()
	for _, child in pairs(Container2:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local yPos = 10
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			local pBtn = Instance.new("TextButton")
			pBtn.Parent = Container2
			pBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
			pBtn.BorderColor3 = Color3.fromRGB(0, 255, 128)
			pBtn.Position = UDim2.new(0.05, 0, 0, yPos)
			pBtn.Size = UDim2.new(0, 210, 0, 30)
			pBtn.Font = Enum.Font.SourceSansBold
			pBtn.Text = "مراقبة: " .. p.Name
			pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			pBtn.TextSize = 12

			pBtn.MouseButton1Click:Connect(function()
				if monitoredPlayer == p then
					monitoredPlayer = nil
					Camera.CameraSubject = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
					pBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
					pBtn.Text = "مراقبة: " .. p.Name
				else
					monitoredPlayer = p
					if p.Character and p.Character:FindFirstChild("Humanoid") then
						Camera.CameraSubject = p.Character.Humanoid
						pBtn.BackgroundColor3 = Color3.fromRGB(30, 150, 60)
						pBtn.Text = "إيقاف مراقبة: " .. p.Name
					end
				end
			end)
			yPos = yPos + 40
		end
	end
end

