-- 1. زر فتح الدروب الجوي (مرة واحدة)
createFeatureToggle("AirdropOpenToggle", 10, "فتح الدروب (مرة واحدة)", function(state)
	if state then
		for _, obj in pairs(workspace:GetDescendants()) do
			if obj:IsA("Model") and (string.lower(obj.Name):find("airdrop") or string.lower(obj.Name):find("drop")) then
				for _, prompt in pairs(obj:GetDescendants()) do
					if prompt:IsA("ProximityPrompt") then
						fireproximityprompt(prompt)
					end
				end
			end
		end
	end
end)

-- 2. زر الانتقال للدروب الجوي (مرة واحدة)
createFeatureToggle("AirdropTpToggle", 55, "انتقال للدروب (مرة واحدة)", function(state)
	if state then
		local Character = LocalPlayer.Character
		if Character and Character:FindFirstChild("HumanoidRootPart") then
			for _, obj in pairs(workspace:GetDescendants()) do
				if obj:IsA("Model") and (string.lower(obj.Name):find("airdrop") or string.lower(obj.Name):find("drop")) then
					local targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
					if targetPart then
						Character.HumanoidRootPart.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
						break
					end
				end
			end
		end
	end
end)

-- 3. زر حل المعادلات (مرة واحدة)
createFeatureToggle("MathToggle", 100, "حل المعادلة (مرة واحدة)", function(state)
	if state then
		for _, gui in pairs(LocalPlayer.PlayerGui:GetDescendants()) do
			if gui:IsA("TextLabel") or gui:IsA("TextBox") then
				local text = gui.Text
				local num1, num2 = text:match("(%d+)%s*%+%s*(%d+)")
				if num1 and num2 then
					local answer = tonumber(num1) + tonumber(num2)
					for _, box in pairs(gui.Parent:GetDescendants()) do
						if box:IsA("TextBox") then
							box.Text = tostring(answer)
						end
					end
					for _, btn in pairs(gui.Parent:GetDescendants()) do
						if btn:IsA("TextButton") and (string.lower(btn.Text):find("تأكيد") or string.lower(btn.Text):find("confirm")) then
							for _, connection in pairs(getconnections(btn.MouseButton1Click)) do
								connection:Fire()
							end
						end
					end
				end
			end
		end
	end
end)

