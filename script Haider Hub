local monitoredPlayer = nil
local updatePlayerListFunc

updatePlayerListFunc = function()
	for _, child in pairs(Container2:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	if not playerListActive then return end

	local yPos = 65
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			local playerCard = Instance.new("Frame")
			playerCard.Parent = Container2
			playerCard.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
			playerCard.BorderColor3 = Color3.fromRGB(0, 160, 255)
			playerCard.Position = UDim2.new(0.05, 0, 0, yPos)
			playerCard.Size = UDim2.new(0, 345, 0, 105)

			local pLabel = Instance.new("TextLabel")
			pLabel.Parent = playerCard
			pLabel.BackgroundTransparency = 1
			pLabel.Position = UDim2.new(0.05, 0, 0, 3)
			pLabel.Size = UDim2.new(0.9, 0, 0, 22)
			pLabel.Font = Enum.Font.SourceSansBold
			pLabel.Text = "اللاعب: " .. p.Name
			pLabel.TextColor3 = Color3.fromRGB(0, 190, 255)
			pLabel.TextSize = 14
			pLabel.TextXAlignment = Enum.TextXAlignment.Left

			-- زر مراقبة الكاميرا
			local specBtn = Instance.new("TextButton")
			specBtn.Parent = playerCard
			specBtn.BackgroundColor3 = Color3.fromRGB(30, 90, 160)
			specBtn.Position = UDim2.new(0.05, 0, 0, 30)
			specBtn.Size = UDim2.new(0, 155, 0, 32)
			specBtn.Font = Enum.Font.SourceSansBold
			specBtn.Text = "مراقبة الكاميرا"
			specBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			specBtn.TextSize = 12

			specBtn.MouseButton1Click:Connect(function()
				if monitoredPlayer == p then
					monitoredPlayer = nil
					Camera.CameraSubject = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
					specBtn.BackgroundColor3 = Color3.fromRGB(30, 90, 160)
					specBtn.Text = "مراقبة الكاميرا"
				else
					monitoredPlayer = p
					if p.Character and p.Character:FindFirstChild("Humanoid") then
						Camera.CameraSubject = p.Character.Humanoid
						specBtn.BackgroundColor3 = Color3.fromRGB(20, 140, 70)
						specBtn.Text = "إيقاف المراقبة"
					end
				end
			end)

			-- زر الانتقال (TP)
			local tpBtn = Instance.new("TextButton")
			tpBtn.Parent = playerCard
			tpBtn.BackgroundColor3 = Color3.fromRGB(160, 90, 30)
			tpBtn.Position = UDim2.new(0.51, 0, 0, 30)
			tpBtn.Size = UDim2.new(0, 155, 0, 32)
			tpBtn.Font = Enum.Font.SourceSansBold
			tpBtn.Text = "انتقال إليه (TP)"
			tpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			tpBtn.TextSize = 12

			tpBtn.MouseButton1Click:Connect(function()
				if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
					LocalPlayer.Character.HumanoidRootPart.CFrame = p.Character.HumanoidRootPart.CFrame + Vector3.new(0, 4, 0)
				end
			end)

			-- زر الرفسة / الفلنق
