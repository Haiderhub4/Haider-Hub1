-- 4. طيران الجوستيك للهاتف (Joystick Fly)
createFeatureToggle(Container1, "JoyFlyToggle", 235, "طيران بالجوستيك (حرك العصا للطيارة ✈️)", function(state)
	joyFlyActive = state
	local Character = LocalPlayer.Character
	if not Character or not Character:FindFirstChild("HumanoidRootPart") then return end
	
	if joyFlyActive then
		local hrp = Character.HumanoidRootPart
		local humanoid = Character:FindFirstChildOfClass("Humanoid")
		
		local bv = Instance.new("BodyVelocity")
		bv.Name = "JoyFlyVel"
		bv.Parent = hrp
		bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		bv.Velocity = Vector3.new(0, 0, 0)
		
		local bg = Instance.new("BodyGyro")
		bg.Name = "JoyFlyGyro"
		bg.Parent = hrp
		bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
		bg.CFrame = hrp.CFrame
		
		task.spawn(function()
			while joyFlyActive and Character and Character:FindFirstChild("HumanoidRootPart") do
				RunService.RenderStepped:Wait()
				local camCF = Camera.CFrame
				local moveDir = humanoid and humanoid.MoveDirection or Vector3.new(0,0,0)
				
				if moveDir.Magnitude > 0 then
					bv.Velocity = ((camCF.LookVector * moveDir.Z) + (camCF.RightVector * moveDir.X) + Vector3.new(0, moveDir.Y, 0)).Unit * joyFlySpeed
				else
					bv.Velocity = Vector3.new(0, 0, 0) -- يقف في مكانه إذا لم تحرك الجوستيك
				end
				bg.CFrame = camCF
			end
			if bv then bv:Destroy() end
			if bg then bg:Destroy() end
		end)
	else
		if Character.HumanoidRootPart:FindFirstChild("JoyFlyVel") then
			Character.HumanoidRootPart.JoyFlyVel:Destroy()
		end
		if Character.HumanoidRootPart:FindFirstChild("JoyFlyGyro") then
			Character.HumanoidRootPart.JoyFlyGyro:Destroy()
		end
	end
end)

