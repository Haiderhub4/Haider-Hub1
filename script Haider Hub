local mathSolvedForCurrentGui = false
task.spawn(function()
	while true do
		task.wait(0.3)
		if autoMathActive then
			pcall(function()
				local foundGui = false
				for _, gui in pairs(LocalPlayer.PlayerGui:GetDescendants()) do
					if gui:IsA("TextLabel") or gui:IsA("TextBox") then
						local text = gui.Text
						local n1, op, n2 = text:match("(%-?%d+)%s*([%+%-*/])%s*(%-?%d+)")
						if n1 and op and n2 then
							foundGui = true
							if not mathSolvedForCurrentGui then
								n1, n2 = tonumber(n1), tonumber(n2)
								local ans = 0
								if op == "+" then ans = n1 + n2
								elseif op == "-" then ans = n1 - n2
								elseif op == "*" then ans = n1 * n2
								elseif op == "/" and n2 ~= 0 then ans = n1 / n2 end
								
								for _, box in pairs(gui.Parent:GetDescendants()) do
									if box:IsA("TextBox") then
										box.Text = tostring(ans)
									end
								end
								for _, btn in pairs(gui.Parent:GetDescendants()) do
									if btn:IsA("TextButton") and (string.lower(btn.Text):find("تأكيد") or string.lower(btn.Text):find("confirm") or string.lower(btn.Text):find("حل")) then
										for _, connection in pairs(getconnections(btn.MouseButton1Click)) do
											connection:Fire()
										end
									end
								end
								mathSolvedForCurrentGui = true
							end
						end
					end
				end
				if not foundGui then
					mathSolvedForCurrentGui = false
				end
			end)
		end
	end
end)

